# =============================================================================
# MT Wallet Web (self-custodial) — variables de entorno de EJEMPLO, sin secretos
# -----------------------------------------------------------------------------
# Copiar a wallet/.env (gitignored) y completar. Este archivo sólo documenta
# variables: nunca lleva valores secretos reales.
# Detalle de cada variable (para qué sirve, proveedor, cómo obtenerla, permisos
# mínimos, entorno y obligatoriedad): wallet/docs/SETUP_EXTERNAL_SERVICES.md
#
# Marcas:
#   [USER local]     credencial externa que sólo el usuario puede obtener y que
#                    ya hace falta en local (el preflight primero la busca y la
#                    valida sin mostrarla)
#   [USER stg/prod]  credencial o dato externo necesario en staging/production
#   [GEN local]      la genera `pnpm secrets:local` (sólo APP_ENV=local)
#   [OPC]            opcional
# Los valores no secretos de este archivo son los defaults de local.
# Toda ruta relativa se resuelve desde `wallet/` (el cargador de config de cada
# proyecto la normaliza).
# Staging/production NO usan este archivo: las variables no secretas van en
# infra/production/.env.production.example (P26) y los secretos como archivos
# de secrets de Docker Compose leídos con <VAR>_FILE (ADR-030), generados en el
# host por scripts/deploy/init-secrets.sh al desplegar.
# =============================================================================

# --- General -----------------------------------------------------------------
APP_ENV=local                         # local | staging | production
PLATFORM_ID=mt-default                # tenant/plataforma (multi-tenant futuro)
CHAIN_ID=8453                         # Base mainnet (el fork local conserva 8453)
LOG_LEVEL=info

# --- Base mainnet RPC upstream -----------------------------------------------
BASE_RPC_URL=                         # [USER local] Alchemy Base mainnet con datos archive (fork local/CI)
BASE_RPC_URL_SECONDARY=               # [USER stg/prod] [OPC local] QuickNode Base mainnet (proveedor distinto)
FORK_BLOCK_NUMBER=52700000            # bloque fijado y verificado (planner §3.1); cambiarlo sólo con runbooks/fork.md

# --- Fork local (Anvil vía docker compose) ------------------------------------
ANVIL_HOST_PORT=8545
ANVIL_COMPUTE_UNITS_PER_SECOND=330   # tope de CU/s de Anvil hacia BASE_RPC_URL (la key admite ~500 CU/s en total; docs/CI.md)
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_SEED=                           # [GEN local] semilla de claves determinísticas SÓLO para seed/tests locales

# --- Infra local (docker compose) ---------------------------------------------
POSTGRES_HOST_PORT=55432
POSTGRES_USER=mtw_admin
POSTGRES_PASSWORD=                    # [GEN local]
POSTGRES_DB=mtw_wallet
MTW_APP_DB_PASSWORD=                  # [GEN local] rol mtw_app
MTW_MIGRATOR_DB_PASSWORD=             # [GEN local] rol mtw_migrator
MTW_SIGNER_DB_PASSWORD=               # [GEN local] rol del signer (DB del signer)
DATABASE_URL=                         # [GEN local] rol mtw_app (DML)
DATABASE_MIGRATION_URL=               # [GEN local] rol mtw_migrator (DDL)
SIGNER_DATABASE_URL=                  # [GEN local] DB propia del signer (mtw_signer_dev)
REDIS_HOST_PORT=56379
REDIS_PASSWORD=                       # [GEN local]
REDIS_URL=                            # [GEN local] Valkey (protocolo Redis)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
GRAFANA_ADMIN_PASSWORD=               # [GEN local] [OPC] sólo perfil compose `observability`

# --- Backend API ----------------------------------------------------------------
API_WALLET_PORT=8080
API_RECOVERY_PORT=8081
API_PUBLIC_URL_WALLET=http://localhost:8080
API_PUBLIC_URL_RECOVERY=http://localhost:8081
WALLET_ORIGIN=http://localhost:5173
RECOVERY_ORIGIN=http://localhost:5174
METRICS_PORT=9464
# Ajustes del backend con default (backend/app/src/config/env.ts); en contenedores API_BIND_HOST=0.0.0.0.
WORKER_METRICS_PORT=9465              # métricas del worker (dispatcher del outbox)
API_BIND_HOST=127.0.0.1
METRICS_BIND_HOST=127.0.0.1           # las métricas nunca se publican fuera de la red interna
TRUST_PROXY=false                     # false | cantidad de proxies (1-5) | IPs/CIDRs del reverse proxy
API_BODY_LIMIT_BYTES=65536
RATE_LIMIT_GLOBAL_PER_MINUTE=         # [OPC] default 1000 en local y 300 en staging/production ([B-RL])
AUTH_FAILURE_SPIKE_PER_MINUTE=60      # fallos de login por minuto (plataforma) que disparan la señal de credential stuffing ([B-AUTH-08])
DATABASE_POOL_MAX=10
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
WORKER_OPERATIONS_CONCURRENCY=8             # Safes en paralelo (una Safe siempre en orden de nonce)
WORKER_LEASE_TTL_MS=30000                   # lease de ejecución por Safe (fencing)
WORKER_RECEIPT_TIMEOUT_MS=60000             # espera del receipt antes de reemplazar por fee bump (≥ 12,5 %)
WORKER_MAX_REPLACEMENTS=3
WORKER_RETRY_BASE_MS=5000                   # backoff exponencial con jitter: base 5 s, máx. 10 min, 20 reintentos
WORKER_RETRY_MAX_MS=600000
WORKER_MAX_RETRIES=20
WATCHER_INTERVAL_MS=2000                    # watcher de finalidad y reorgs
INDEXER_INTERVAL_MS=4000                    # indexer de eventos de SafeL2 y Transfer de USDC/USDT
RECONCILER_INTERVAL_MS=60000                # reconciliación DB ↔ cadena (la completa corre una vez por día)
EFFECTS_INTERVAL_MS=5000                    # whitelist (altas/bajas/activación), grupos de swap y avisos de alto valor
RPC_TIMEOUT_MS=5000
RPC_HEALTH_INTERVAL_MS=10000
RPC_MAX_HEAD_LAG_BLOCKS=10
RPC_QUORUM_RETRIES=3
RPC_QUORUM_BACKOFF_MS=250

# RPC efectivos del backend (local: ambos al fork; stg/prod: claves propias del backend)
RPC_PRIMARY_URL=http://127.0.0.1:8545       # [USER stg/prod] Alchemy (app "backend")
RPC_SECONDARY_URL=http://127.0.0.1:8545     # [USER stg/prod] QuickNode (endpoint "backend")
RPC_QUORUM_MODE=local-single                # local-single | dual (stg/prod: dual)
CONFIRMATION_POLICY=depth                   # depth (local/fork) | tags (stg/prod: safe/finalized)
CONFIRMATION_DEPTH=3                        # sólo con CONFIRMATION_POLICY=depth
FINALIZATION_DEPTH=10                       # sólo con CONFIRMATION_POLICY=depth

# Secretos del backend (en stg/prod se leen de archivos con <VAR>_FILE)
SESSION_SECRET=                       # [GEN local] firma de cookies de sesión
CSRF_SECRET=                          # [GEN local] HMAC de tokens CSRF
SESSION_ISSUER_PRIVATE_KEY=           # [GEN local] Ed25519 PKCS#8 (base64) — firma tokens PlatformSession
SESSION_ISSUER_PUBLIC_KEY=            # [GEN local] pública correspondiente (la fija también el signer)
OPAQUE_SERVER_SETUP=                  # [GEN local, desde P10] secreto de servidor OPAQUE (pnpm --dir backend/app opaque:setup)
APP_FIELD_ENCRYPTION_KEY=             # [GEN local] 32 bytes base64 — cifrado de campos sensibles (secretos TOTP)
OTP_HMAC_KEY=                         # [GEN local] 32 bytes base64 — hash de códigos OTP
PASSWORD_PEPPER_V1=                   # [GEN local] 32 bytes base64 — pepper del hash de passwords de cuenta
AUDIT_CHAIN_KEY=                      # [GEN local] 32 bytes base64 — cadena HMAC del audit log

# --- Email ------------------------------------------------------------------------
EMAIL_PROVIDER=smtp                   # smtp (local: Mailpit) | mailgun (tests reales y stg/prod)
EMAIL_FROM=no-reply@wallet.localhost  # tests reales: no-reply@<EMAIL_PROVIDER_DOMAIN>; stg/prod: remitente del dominio verificado en Mailgun
EMAIL_PROVIDER_API_KEY=               # [USER local] Mailgun API key (sandbox para los tests reales; stg/prod: una por entorno)
EMAIL_PROVIDER_DOMAIN=                # [USER local] dominio de Mailgun (sandbox…mailgun.org en tests; dominio propio en stg/prod)
EMAIL_PROVIDER_BASE_URL=https://api.mailgun.net   # región US (EU: https://api.eu.mailgun.net)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_NETWORK_LABEL=                  # [OPC] red que muestran los emails ([B-MAIL-02]); default según APP_ENV (ver backend/app/src/email/format.ts)

# --- Signer S (signer-service self-hosted por shard) ---------------------------------
SIGNER_PROVIDER=development           # development (sólo local sobre Anvil) | selfhosted (staging/production)
SIGNER_SHARD_ID=dev-1                 # shard que atiende este proceso del signer
SIGNER_HOST=127.0.0.1                 # local: sólo loopback; en el contenedor del shard 0.0.0.0 (red Docker `signer` interna, sin puertos publicados)
SIGNER_PORT=8090
SIGNER_SHARDS='[{"id":"dev-1","url":"https://127.0.0.1:8090"}]'   # shards de S que conoce el backend ("active": false deja de recibir wallets nuevas)
SIGNER_PLATFORM_URL=https://127.0.0.1:8091                         # shard `platform` (cuenta gas tank) que usa el backend
SIGNER_TIMEOUT_MS=30000
SIGNER_KEYSTORE_DIR=./.secrets/signer/dev-1/keystore              # keystores Ethereum V3 cifrados (prod: volumen del shard)
SIGNER_UNLOCK_CREDENTIAL_FILE=./.secrets/signer/dev-1/unlock.key  # [GEN local] credencial de desbloqueo del shard, SEPARADA de los keystores (prod: /run/secrets/signer_unlock)
SIGNER_PLATFORM_PORT=8091                                           # local: `pnpm --dir backend/signer dev -- --shard platform`
SIGNER_PLATFORM_KEYSTORE_DIR=./.secrets/signer/platform/keystore    # keystore de la cuenta gas tank
SIGNER_PLATFORM_UNLOCK_CREDENTIAL_FILE=./.secrets/signer/platform/unlock.key  # [GEN local] credencial del shard platform
SIGNER_PLATFORM_DATABASE_URL=         # [GEN local] DB propia del shard platform (mtw_signer_platform_dev)
SIGNER_ATTESTATION_PRIVATE_KEY=       # [GEN local] Ed25519 — firma SignerKeyAttestation (prod: archivo de secrets)
SIGNER_ATTESTATION_PUBLIC_KEY=        # [GEN local] pública; la embeben los frontends por entorno
SIGNER_RPC_PRIMARY_URL=http://127.0.0.1:8545    # [USER stg/prod] Alchemy (app "signer", distinta del backend)
SIGNER_RPC_SECONDARY_URL=http://127.0.0.1:8545  # [USER stg/prod] QuickNode (endpoint "signer")
MTLS_CA_CERT_PATH=./.secrets/mtls/ca.pem                     # [GEN local]
MTLS_BACKEND_CLIENT_CERT_PATH=./.secrets/mtls/backend-client.pem
MTLS_BACKEND_CLIENT_KEY_PATH=./.secrets/mtls/backend-client-key.pem
MTLS_SIGNER_SERVER_CERT_PATH=./.secrets/mtls/signer-server.pem
MTLS_SIGNER_SERVER_KEY_PATH=./.secrets/mtls/signer-server-key.pem
MTLS_ALLOWED_CLIENT_NAMES=mtw-backend  # CN o SAN DNS de los certificados de cliente que acepta el signer
POLICY_SNAPSHOT_PATH=./config/policy/local/policy-snapshot.json
POLICY_SIGNING_PUBLIC_KEY=            # [GEN local] stg/prod: pública de la clave de policy del equipo de seguridad
POLICY_SIGNING_PRIVATE_KEY_LOCAL=     # [GEN local] SÓLO local; en stg/prod la privada nunca está en servidores
INTEGRITY_REQUIRED=false              # stg/prod: true (fail-closed)
INTEGRITY_MONITOR_PRIVATE_KEY=        # [GEN local] Ed25519 — firma atestaciones de integridad
INTEGRITY_MONITOR_PUBLIC_KEY=         # [GEN local] la fija el signer
WALLET_RELEASE_PUBLIC_KEY=            # [GEN local] stg/prod: pública de la clave de release de Wallet
RECOVERY_RELEASE_PUBLIC_KEY=          # [GEN local] stg/prod: pública de la clave de release de Recovery
WALLET_RELEASE_SIGNING_KEY_LOCAL=     # [GEN local] SÓLO local; stg/prod: secreto del GitHub Environment de Wallet
RECOVERY_RELEASE_SIGNING_KEY_LOCAL=   # [GEN local] SÓLO local; stg/prod: secreto del GitHub Environment de Recovery
SOVEREIGN_EXIT_RELEASE_PUBLIC_KEY=    # [GEN local] release: pública de la clave de la herramienta de salida soberana
SOVEREIGN_EXIT_RELEASE_SIGNING_KEY_LOCAL= # [GEN local] SÓLO local; release: secreto del pipeline de la herramienta

# --- Gas tank / relayer (cuenta de plataforma, no owner de Safes) -------------------
GAS_TOPUP_MIN_WEI=200000000000000           # 0.0002 ETH
GAS_TOPUP_TARGET_WEI=1000000000000000       # 0.001 ETH
GAS_TANK_DAILY_CAP_WEI=50000000000000000    # 0.05 ETH
GAS_TANK_INTERVAL_MS=30000                  # pasada de recargas del proceso gas-tank
GAS_TANK_METRICS_PORT=9466

# --- Contratos / despliegue -----------------------------------------------------------
DEPLOYER_KEY_SOURCE=local-seed        # local-seed (sólo fork) | ledger | trezor (stg/prod: hardware wallet obligatoria)
GOVERNANCE_SAFE_ADDRESS=              # [USER stg/prod] admin del PolicyRegistry (multisig con hardware wallets); local: lo crea el seed
POLICY_GUARDIANS=                     # [USER stg/prod] direcciones separadas por coma
ETHERSCAN_API_KEY=                    # [USER stg/prod deploy] Etherscan API V2 (verificación en Base)

# --- Alertas (Alertmanager self-hosted) ------------------------------------------------
ALERT_EMAIL=                          # [USER stg/prod] casilla de guardia (local: llega a Mailpit)
ALERT_WEBHOOK_URL=                    # [OPC] webhook adicional para alertas

# --- Frontend Wallet (público, se inyecta en build; nunca secretos) ------------------
WALLET_API_BASE_URL=http://localhost:8080/api/v1
WALLET_FRONTEND_RPC_URL=http://127.0.0.1:8545   # [USER stg/prod] Alchemy (app "wallet-frontend" con allowlist de dominio)
GOOGLE_CLIENT_ID_WALLET=              # [USER local] OAuth client ID (proyecto Google Cloud de Wallet)
GOOGLE_OAUTH_REDIRECT_URI_WALLET=http://localhost:5173/oauth/google/callback
# GOOGLE_CLIENT_SECRET_WALLET -> NO SE USA (cliente público en navegador; ver SETUP_EXTERNAL_SERVICES.md)

# --- Frontend Recovery (público, se inyecta en build; nunca secretos) ----------------
RECOVERY_API_BASE_URL=http://localhost:8081/api/v1
RECOVERY_FRONTEND_RPC_URL=http://127.0.0.1:8545 # [USER stg/prod] Alchemy (app "recovery-frontend" con allowlist de dominio)
GOOGLE_CLIENT_ID_RECOVERY=            # [USER local] OAuth client ID (proyecto Google Cloud de Recovery, distinto del de Wallet)
GOOGLE_OAUTH_REDIRECT_URI_RECOVERY=http://localhost:5174/oauth/google/callback
# GOOGLE_CLIENT_SECRET_RECOVERY -> NO SE USA
WALLETCONNECT_PROJECT_ID=             # [USER local] Reown (dashboard.reown.com), sólo lo usa Recovery

# --- Tests contra servicios reales (obligatorios; ver SETUP_EXTERNAL_SERVICES.md) -------
GOOGLE_DRIVE_TEST_CLIENT_ID=          # [USER local] cliente OAuth de TEST para los tests contra la API real de Drive
GOOGLE_DRIVE_TEST_CLIENT_SECRET=      # [USER local] secreto de ese cliente de TEST (nunca lo usa el producto)
GOOGLE_DRIVE_TEST_REFRESH_TOKEN=      # [USER local] refresh token de la cuenta Google de prueba
EMAIL_TEST_ADDRESS=                   # [USER local] casilla Gmail de prueba, autorizada en el sandbox de Mailgun
EMAIL_TEST_GOOGLE_CLIENT_ID=          # [USER local] cliente OAuth de TEST para leer esa casilla con la Gmail API (puede ser `drive-tests`)
EMAIL_TEST_GOOGLE_CLIENT_SECRET=      # [USER local] secreto de ese cliente (nunca lo usa el producto)
EMAIL_TEST_GOOGLE_REFRESH_TOKEN=      # [USER local] refresh token de EMAIL_TEST_ADDRESS con scope gmail.readonly
