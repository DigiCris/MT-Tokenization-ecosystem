# =============================================================================
# MT Wallet Web (self-custodial) — variables de entorno de EJEMPLO, sin secretos
# -----------------------------------------------------------------------------
# Copiar a wallet/.env (gitignored) y completar.
# Detalle de cada variable (para qué sirve, proveedor, cómo obtenerla, permisos
# mínimos, entorno y obligatoriedad): wallet/docs/SETUP_EXTERNAL_SERVICES.md
#
# Marcas:
#   [EXT-REQ local]  credencial externa obligatoria ya en local (STOP si falta)
#   [EXT-REQ stg/prod] credencial externa obligatoria en staging/production
#   [GEN local]      la genera `pnpm secrets:local` (sólo APP_ENV=local);
#                    en staging/production se genera una vez y vive en el
#                    secret manager, nunca en archivos
#   [OPC]            opcional
# Los valores no secretos de este archivo son los defaults de local.
# Toda ruta relativa se resuelve desde `wallet/` (el cargador de config de cada
# proyecto la normaliza).
# =============================================================================

# --- General -----------------------------------------------------------------
APP_ENV=local                         # local | staging | production
PLATFORM_ID=mt-default                # tenant/plataforma (multi-tenant futuro)
CHAIN_ID=8453                         # Base mainnet (el fork local conserva 8453)
LOG_LEVEL=info

# --- Base mainnet RPC upstream -----------------------------------------------
BASE_RPC_URL=                         # [EXT-REQ local] Alchemy Base mainnet con datos archive (fork + backend primario en stg/prod)
BASE_RPC_URL_SECONDARY=               # [EXT-REQ stg/prod] [OPC local] QuickNode Base mainnet (proveedor distinto)
FORK_BLOCK_NUMBER=52700000            # bloque fijado y verificado (planner §3.1); cambiarlo sólo con runbooks/fork.md

# --- Fork local (Anvil vía docker compose) ------------------------------------
ANVIL_HOST_PORT=8545
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_SEED=                           # [GEN local] semilla de claves determinísticas SÓLO para seed/tests locales

# --- Infra local (docker compose) ---------------------------------------------
POSTGRES_HOST_PORT=55432
POSTGRES_USER=mtw_admin
POSTGRES_PASSWORD=                    # [GEN local]
POSTGRES_DB=mtw_wallet
MTW_APP_DB_PASSWORD=                  # [GEN local] rol mtw_app
MTW_MIGRATOR_DB_PASSWORD=             # [GEN local] rol mtw_migrator
MTW_SIGNER_DB_PASSWORD=               # [GEN local] rol mtw_signer (DB del signer)
DATABASE_URL=                         # [GEN local] rol mtw_app (DML)
DATABASE_MIGRATION_URL=               # [GEN local] rol mtw_migrator (DDL)
SIGNER_DATABASE_URL=                  # [GEN local] DB propia del signer (mtw_signer_dev)
REDIS_HOST_PORT=56379
REDIS_PASSWORD=                       # [GEN local]
REDIS_URL=                            # [GEN local] Valkey (protocolo Redis)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
GRAFANA_ADMIN_PASSWORD=               # [GEN local] sólo perfil compose `observability` (P24); en producción Amazon Managed Grafana usa SSO, sin credenciales estáticas

# --- Backend API ----------------------------------------------------------------
API_WALLET_PORT=8080
API_RECOVERY_PORT=8081
API_PUBLIC_URL_WALLET=http://localhost:8080
API_PUBLIC_URL_RECOVERY=http://localhost:8081
WALLET_ORIGIN=http://localhost:5173
RECOVERY_ORIGIN=http://localhost:5174
METRICS_PORT=9464

# RPC efectivos del backend (local: ambos al fork; stg/prod: claves propias del backend)
RPC_PRIMARY_URL=http://127.0.0.1:8545       # [EXT-REQ stg/prod] Alchemy (app "backend")
RPC_SECONDARY_URL=http://127.0.0.1:8545     # [EXT-REQ stg/prod] QuickNode (endpoint "backend")
RPC_QUORUM_MODE=local-single                # local-single | dual (stg/prod: dual)
CONFIRMATION_POLICY=depth                   # depth (local/fork) | tags (stg/prod: safe/finalized)
CONFIRMATION_DEPTH=3                        # sólo con CONFIRMATION_POLICY=depth
FINALIZATION_DEPTH=10                       # sólo con CONFIRMATION_POLICY=depth

# Secretos del backend
SESSION_SECRET=                       # [GEN local] firma de cookies de sesión
CSRF_SECRET=                          # [GEN local] HMAC de tokens CSRF
SESSION_ISSUER_PRIVATE_KEY=           # [GEN local] Ed25519 PKCS#8 (base64) — firma tokens PlatformSession
SESSION_ISSUER_PUBLIC_KEY=            # [GEN local] pública correspondiente (la fija también el signer)
OPAQUE_SERVER_SETUP=                  # [GEN local, desde P10] secreto de servidor OPAQUE (pnpm --dir backend/app opaque:setup)
APP_FIELD_ENCRYPTION_KEY=             # [GEN local] 32 bytes base64 — cifrado de campos sensibles (secretos TOTP)
OTP_HMAC_KEY=                         # [GEN local] 32 bytes base64 — hash de códigos OTP
PASSWORD_PEPPER_V1=                   # [GEN local] 32 bytes base64 — pepper del hash de passwords de cuenta
AUDIT_CHAIN_KEY=                      # [GEN local] 32 bytes base64 — cadena HMAC del audit log

# --- Email ------------------------------------------------------------------------
EMAIL_PROVIDER=smtp                   # smtp (local: Mailpit) | postmark (stg/prod)
EMAIL_FROM=no-reply@wallet.localhost  # stg/prod: remitente verificado en Postmark
EMAIL_PROVIDER_API_KEY=               # [EXT-REQ stg/prod] [OPC local] Postmark Server API Token
EMAIL_MESSAGE_STREAM=outbound         # stream transaccional de Postmark
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# --- Signer S (signer-service por shard) --------------------------------------------
SIGNER_PROVIDER=development           # development (sólo local sobre Anvil) | kms (stg/prod)
SIGNER_PORT=8090
SIGNER_SHARDS='[{"id":"dev-1","url":"https://127.0.0.1:8090"}]'
SIGNER_RPC_PRIMARY_URL=http://127.0.0.1:8545    # [EXT-REQ stg/prod] Alchemy (app "signer", distinta del backend)
SIGNER_RPC_SECONDARY_URL=http://127.0.0.1:8545  # [EXT-REQ stg/prod] QuickNode (endpoint "signer")
MTLS_CA_CERT_PATH=./.secrets/mtls/ca.pem                     # [GEN local]
MTLS_BACKEND_CLIENT_CERT_PATH=./.secrets/mtls/backend-client.pem
MTLS_BACKEND_CLIENT_KEY_PATH=./.secrets/mtls/backend-client-key.pem
MTLS_SIGNER_SERVER_CERT_PATH=./.secrets/mtls/signer-server.pem
MTLS_SIGNER_SERVER_KEY_PATH=./.secrets/mtls/signer-server-key.pem
DEV_SIGNER_KEYSTORE_DIR=./.secrets/dev-signer-keystore
DEV_SIGNER_KEYSTORE_PASSPHRASE=       # [GEN local]
AWS_REGION=                           # [EXT-REQ stg/prod] región de KMS/servicios (las credenciales salen del rol IAM, nunca de este archivo)
KMS_KEY_ALIAS_PREFIX=                 # [EXT-REQ stg/prod] p. ej. alias/mtw/production
POLICY_SNAPSHOT_PATH=./config/policy/local/policy-snapshot.json
POLICY_SIGNING_PUBLIC_KEY=            # [GEN local] stg/prod: clave pública del equipo de seguridad
POLICY_SIGNING_PRIVATE_KEY_LOCAL=     # [GEN local] SÓLO local; en stg/prod la privada nunca está en servidores
INTEGRITY_REQUIRED=false              # stg/prod: true (fail-closed)
INTEGRITY_MONITOR_PRIVATE_KEY=        # [GEN local] Ed25519 — firma atestaciones de integridad
INTEGRITY_MONITOR_PUBLIC_KEY=         # [GEN local] la fija el signer
WALLET_RELEASE_PUBLIC_KEY=            # [GEN local] stg/prod: pública de la clave de release de Wallet
RECOVERY_RELEASE_PUBLIC_KEY=          # [GEN local] stg/prod: pública de la clave de release de Recovery
WALLET_RELEASE_SIGNING_KEY_LOCAL=     # [GEN local] SÓLO local; stg/prod: secreto del GitHub Environment de Wallet
RECOVERY_RELEASE_SIGNING_KEY_LOCAL=   # [GEN local] SÓLO local; stg/prod: secreto del GitHub Environment de Recovery

# --- Gas tank / relayer (cuenta de plataforma, no owner de Safes) -------------------
GAS_TOPUP_MIN_WEI=200000000000000           # 0.0002 ETH
GAS_TOPUP_TARGET_WEI=1000000000000000       # 0.001 ETH
GAS_TANK_DAILY_CAP_WEI=50000000000000000    # 0.05 ETH

# --- Contratos / despliegue -----------------------------------------------------------
DEPLOYER_KEY_SOURCE=local-seed        # local-seed (sólo fork) | ledger | trezor (stg/prod: hardware wallet obligatoria)
GOVERNANCE_SAFE_ADDRESS=              # [EXT-REQ stg/prod] admin del PolicyRegistry (multisig con hardware wallets); local: lo crea el seed
POLICY_GUARDIANS=                     # [EXT-REQ stg/prod] direcciones separadas por coma
ETHERSCAN_API_KEY=                    # [EXT-REQ stg/prod deploy] Etherscan API V2 (verificación en Base)

# --- Frontend Wallet (público, se inyecta en build; nunca secretos) ------------------
WALLET_API_BASE_URL=http://localhost:8080/api/v1
WALLET_FRONTEND_RPC_URL=http://127.0.0.1:8545   # [EXT-REQ stg/prod] Alchemy (app "wallet-frontend" con allowlist de dominio)
GOOGLE_CLIENT_ID_WALLET=              # [EXT-REQ local] OAuth client ID (proyecto Google Cloud de Wallet)
GOOGLE_OAUTH_REDIRECT_URI_WALLET=http://localhost:5173/oauth/google/callback
# GOOGLE_CLIENT_SECRET_WALLET -> NO SE USA (cliente público en navegador; ver SETUP_EXTERNAL_SERVICES.md)

# --- Frontend Recovery (público, se inyecta en build; nunca secretos) ----------------
RECOVERY_API_BASE_URL=http://localhost:8081/api/v1
RECOVERY_FRONTEND_RPC_URL=http://127.0.0.1:8545 # [EXT-REQ stg/prod] Alchemy (app "recovery-frontend" con allowlist de dominio)
GOOGLE_CLIENT_ID_RECOVERY=            # [EXT-REQ local] OAuth client ID (proyecto Google Cloud de Recovery, distinto del de Wallet)
GOOGLE_OAUTH_REDIRECT_URI_RECOVERY=http://localhost:5174/oauth/google/callback
# GOOGLE_CLIENT_SECRET_RECOVERY -> NO SE USA
WALLETCONNECT_PROJECT_ID=             # [EXT-REQ local] Reown (dashboard.reown.com), sólo lo usa Recovery

# --- Tests opcionales con servicios reales ---------------------------------------------
GOOGLE_DRIVE_TEST_CLIENT_ID=          # [OPC] cliente OAuth de TEST (sólo CI nightly del cliente Drive)
GOOGLE_DRIVE_TEST_CLIENT_SECRET=      # [OPC] secreto de ese cliente de TEST (nunca usado por el producto)
GOOGLE_DRIVE_TEST_REFRESH_TOKEN=      # [OPC] refresh token de la cuenta Google de pruebas
POSTMARK_TEST_RECIPIENT=              # [OPC] casilla para smoke test real de email

# --- Sólo staging/production (se inyectan desde Secrets Manager / CI; NO completar aquí) ---
# WALLET_DOMAIN, RECOVERY_DOMAIN, AWS_ACCOUNT_ID_BACKEND, AWS_ACCOUNT_ID_SIGNER,
# AWS_ACCOUNT_ID_WALLET_FE, AWS_ACCOUNT_ID_RECOVERY_FE, AWS_DEPLOY_ROLE_ARN_<AREA>_<ENV>,
# AWS_KMS_TEST_ROLE_ARN_STAGING (CI: tests de KmsSignerProvider), ALERT_EMAIL, ALERT_SMS_NUMBER
