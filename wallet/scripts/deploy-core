#!/usr/bin/env bash
# Deploy de los contratos del sistema sobre el fork (contracts/script/DeployCore.s.sol, [C-SCR-01]) seguido de la
# verificación completa on-chain (VerifyDeployment.s.sol, [C-SCR-02]). Ver docs/runbooks/deploy.md.
#
# Uso: scripts/deploy-core [local|ci|fork/staging|fork/production] [argumentos extra de forge script]
#   local      deployer, Governance Safe 2-de-3 y guardianes derivados de LOCAL_SEED (sólo Anvil).
#   ci         igual que local sobre el Anvil efímero del job de contratos (deployments/ci.json).
#   fork/*     ensayo de staging/producción sobre el fork: GOVERNANCE_SAFE_ADDRESS, POLICY_GUARDIANS,
#              DEPLOYER_ADDRESS, DEPLOYER_KEY_SOURCE=keystore y la wallet del deployer por argumentos
#              (--keystore <archivo> --password-file <archivo>); exige árbol limpio y deployer con nonce 0.
#
# DeployCore se niega a transmitir si el RPC no es Anvil.
set -euo pipefail
WALLET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=env.sh
source "$WALLET_ROOT/scripts/env.sh"
# shellcheck source=lib/deploy-env.sh
source "$WALLET_ROOT/scripts/lib/deploy-env.sh"

network="${1:-local}"
[ "$#" -gt 0 ] && shift
deploy_env "$network"

cd "$WALLET_ROOT/contracts"
# Lo que Anvil no tiene lo pide al RPC de Base con reintentos (hasta 60 s por pedido): forge espera hasta 300 s, no 45.
rpc_timeout=(--rpc-timeout 300)
# Fondeo previo en otra invocación: la simulación on-chain de forge usa el estado del bloque en que arranca.
forge script script/FundForkAccounts.s.sol --rpc-url "$DEPLOY_RPC" "${rpc_timeout[@]}"
# El broadcast EIP-1559 estima los fees con eth_feeHistory de los últimos 10 bloques; si el rango toca bloques anteriores
# al fork, Anvil se lo pide al RPC de Base. Con 10 bloques propios minados antes, la estimación no sale del Anvil.
# Sin Anvil no hay nada que minar: DeployCore igual se niega a transmitir.
cast rpc anvil_mine 0xa --rpc-url "$DEPLOY_RPC" >/dev/null 2>&1 || true
forge script script/DeployCore.s.sol --rpc-url "$DEPLOY_RPC" --broadcast --slow "${rpc_timeout[@]}" "$@"
forge script script/VerifyDeployment.s.sol --rpc-url "$DEPLOY_RPC" "${rpc_timeout[@]}"
