#!/usr/bin/env bash
# Levanta sólo el servicio anvil (fork de Base mainnet en FORK_BLOCK_NUMBER) y espera chainId 0x2105.
set -euo pipefail
WALLET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=env.sh
source "$WALLET_ROOT/scripts/env.sh"
cd "$WALLET_ROOT"
docker compose up -d anvil
node scripts/lib/fork.mjs wait
