#!/usr/bin/env bash
# Genera secretos LOCALES aleatorios en wallet/.env y wallet/.secrets/ (P00.T04).
# Sólo con APP_ENV=local; nunca sobrescribe valores existentes. Uso: pnpm secrets:local [--regen-mtls]
set -euo pipefail
WALLET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=env.sh
source "$WALLET_ROOT/scripts/env.sh"
command -v node >/dev/null 2>&1 || bash "$WALLET_ROOT/scripts/tools/bootstrap" node
exec node "$WALLET_ROOT/scripts/lib/secrets-local.mjs" "$@"
