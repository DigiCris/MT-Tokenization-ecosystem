{
  "name": "mtw-backend-app",
  "version": "0.0.0",
  "private": true,
  "description": "Backend de MT Wallet: API (listeners Wallet y Recovery), worker, watcher, indexer y gas tank.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:security": "vitest run --project security",
    "sync:contracts": "node scripts/sync-contract-artifacts.mjs",
    "check:contracts": "node scripts/sync-contract-artifacts.mjs --check",
    "dev:api": "node --watch src/main.ts api",
    "dev:worker": "node --watch src/main.ts worker",
    "start:api": "node dist/main.js api",
    "start:worker": "node dist/main.js worker",
    "db:migrate": "node src/cli/db.ts migrate",
    "db:status": "node src/cli/db.ts status",
    "db:backup": "node src/cli/db.ts backup",
    "db:restore": "node src/cli/db.ts restore",
    "audit:verify": "node src/cli/audit-verify.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@node-rs/argon2": "2.2.2",
    "@serenity-kit/opaque": "1.1.0",
    "bullmq": "6.3.12",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "nodemailer": "10.0.16",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "testcontainers": "12.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
