{
  "name": "mtw-integrity-monitor",
  "version": "0.0.0",
  "private": true,
  "description": "Integrity monitor de releases de MT Wallet (P20): verifica el manifest firmado, los archivos, el SRI y los headers servidos por Wallet y Recovery y emite IntegrityAttestation firmadas con su propia clave.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "dev": "node --watch src/main.ts serve",
    "start": "node dist/main.js serve",
    "check:once": "node src/main.ts check-once",
    "resume:approve": "node scripts/approve-resume.ts",
    "keys:generate": "node scripts/generate-keys.ts"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "parse5": "8.0.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
