{
  "openapi": "3.1.0",
  "info": {
    "title": "MT Wallet — signer-service (API interna mTLS)",
    "version": "1",
    "description": "API interna de cada shard del signer [B-SIG]. Sólo por mTLS (CA privada del entorno, TLS 1.3, cliente `mtw-backend`) dentro de la red Docker `signer`. No se publica."
  },
  "servers": [
    {
      "url": "https://signer-{shard}:8090",
      "variables": {
        "shard": {
          "default": "dev-1"
        }
      }
    }
  ],
  "security": [
    {
      "mtls": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Estado del shard (provider, claves, versión de policy, kid de atestación)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "enum": [
                        "development",
                        "selfhosted",
                        "hardware"
                      ]
                    },
                    "shardId": {
                      "type": "string"
                    },
                    "ready": {
                      "type": "boolean"
                    },
                    "problems": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "keys": {
                      "type": "object",
                      "properties": {
                        "active": {
                          "type": "integer"
                        },
                        "broken": {
                          "type": "integer"
                        }
                      }
                    },
                    "platform": {
                      "type": "boolean"
                    },
                    "policyVersion": {
                      "type": "integer"
                    },
                    "attestationKid": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Certificado de cliente no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/keys": {
      "post": {
        "summary": "Crear S para una wallet (o la cuenta gas tank del shard platform) con su SignerKeyAttestation [B-SIG-07]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "walletId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "ONBOARDING",
                      "ROTATION",
                      "GAS_TANK"
                    ]
                  }
                },
                "required": [
                  "walletId",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "keyRef": {
                      "type": "string"
                    },
                    "address": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{40}$"
                    },
                    "shardId": {
                      "type": "string"
                    },
                    "attestation": {
                      "type": "string",
                      "description": "JWS EdDSA [W-03]"
                    },
                    "purpose": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Pedido inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Certificado de cliente no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "No disponible (RPC, shard no listo, pausa por integridad)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/keys/retire": {
      "post": {
        "summary": "Retirar una S que ya no es la de su Safe (verificado on-chain); se destruye a los 30 días [B-SIG-08]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "walletId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "address": {
                    "type": "string"
                  },
                  "safe": {
                    "type": "string"
                  }
                },
                "required": [
                  "walletId",
                  "address",
                  "safe"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "keyRef": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "destroyAfter": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Pedido inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Certificado de cliente no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Rechazo definitivo (reglas estáticas, sesión, policy, Guard, simulación)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sign-safe-tx": {
      "post": {
        "summary": "Co-firma de una SafeTx por S tras repetir los pasos 2–8 y 7b de [B-Q-02] [B-SIG-02]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "operationId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "safeTx": {
                    "type": "object",
                    "properties": {
                      "to": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      },
                      "data": {
                        "type": "string"
                      },
                      "operation": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "safeTxGas": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      },
                      "baseGas": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      },
                      "gasPrice": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      },
                      "gasToken": {
                        "type": "string"
                      },
                      "refundReceiver": {
                        "type": "string"
                      },
                      "nonce": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      }
                    },
                    "required": [
                      "to",
                      "value",
                      "data",
                      "operation",
                      "safeTxGas",
                      "baseGas",
                      "gasPrice",
                      "gasToken",
                      "refundReceiver",
                      "nonce"
                    ],
                    "additionalProperties": false
                  },
                  "ownerSignature": {
                    "type": "string"
                  },
                  "submissionEnvelope": {
                    "type": "object",
                    "properties": {
                      "operationId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "safeTxHash": {
                        "type": "string",
                        "pattern": "^0x[0-9a-f]{64}$"
                      },
                      "sessionId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "submittedAt": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "operationId",
                      "safeTxHash",
                      "sessionId",
                      "submittedAt"
                    ],
                    "additionalProperties": false
                  },
                  "submissionEnvelopeSignature": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "walletId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "safe": {
                    "type": "string"
                  },
                  "chainId": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "operationType": {
                    "type": "string",
                    "enum": [
                      "SEND",
                      "SWAP_APPROVE",
                      "SWAP",
                      "APPROVE_REVOKE",
                      "WHITELIST_ADD",
                      "WHITELIST_REMOVE",
                      "ROTATION_PROPOSE",
                      "ROTATION_EXECUTE",
                      "NOOP_CANCEL",
                      "MIGRATION_TRANSFER",
                      "GUARD_UPGRADE"
                    ]
                  },
                  "ownerRole": {
                    "type": "string",
                    "enum": [
                      "U",
                      "R"
                    ]
                  },
                  "platformSessionToken": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "challengeAttestation": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "keyAcceptance": {
                    "type": "object",
                    "properties": {
                      "walletId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "role": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "newKey": {
                        "type": "string"
                      },
                      "nonce": {
                        "type": "string",
                        "pattern": "^0x[0-9a-fA-F]{64}$"
                      },
                      "signature": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "walletId",
                      "role",
                      "newKey",
                      "nonce",
                      "signature"
                    ],
                    "additionalProperties": false
                  },
                  "newKeyAttestation": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "pairedSafeTx": {
                    "type": "object",
                    "properties": {
                      "operationId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "safeTx": {
                        "type": "object",
                        "properties": {
                          "to": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,77})$"
                          },
                          "data": {
                            "type": "string"
                          },
                          "operation": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                          },
                          "safeTxGas": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,77})$"
                          },
                          "baseGas": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,77})$"
                          },
                          "gasPrice": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,77})$"
                          },
                          "gasToken": {
                            "type": "string"
                          },
                          "refundReceiver": {
                            "type": "string"
                          },
                          "nonce": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,77})$"
                          }
                        },
                        "required": [
                          "to",
                          "value",
                          "data",
                          "operation",
                          "safeTxGas",
                          "baseGas",
                          "gasPrice",
                          "gasToken",
                          "refundReceiver",
                          "nonce"
                        ],
                        "additionalProperties": false
                      },
                      "ownerSignature": {
                        "type": "string"
                      },
                      "submissionEnvelope": {
                        "type": "object",
                        "properties": {
                          "operationId": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "safeTxHash": {
                            "type": "string",
                            "pattern": "^0x[0-9a-f]{64}$"
                          },
                          "sessionId": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "submittedAt": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "operationId",
                          "safeTxHash",
                          "sessionId",
                          "submittedAt"
                        ],
                        "additionalProperties": false
                      },
                      "submissionEnvelopeSignature": {
                        "type": "string",
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "operationId",
                      "safeTx",
                      "ownerSignature",
                      "submissionEnvelope",
                      "submissionEnvelopeSignature"
                    ],
                    "additionalProperties": false
                  },
                  "replacesSafeTxHash": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  },
                  "integrityAttestations": {
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 8192
                    }
                  },
                  "policySnapshotVersion": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "execution": {
                    "type": "object",
                    "properties": {
                      "accountNonce": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      },
                      "maxFeePerGas": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      },
                      "maxPriorityFeePerGas": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      },
                      "gasLimit": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      }
                    },
                    "required": [
                      "accountNonce",
                      "maxFeePerGas",
                      "maxPriorityFeePerGas"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "operationId",
                  "safeTx",
                  "ownerSignature",
                  "submissionEnvelope",
                  "submissionEnvelopeSignature",
                  "walletId",
                  "safe",
                  "chainId",
                  "operationType",
                  "ownerRole",
                  "platformSessionToken",
                  "policySnapshotVersion",
                  "execution"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "operationId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "safeTxHash": {
                      "type": "string",
                      "pattern": "^0x([0-9a-fA-F]{2})*$"
                    },
                    "executor": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{40}$"
                    },
                    "sSignature": {
                      "type": "string",
                      "pattern": "^0x([0-9a-fA-F]{2})*$"
                    },
                    "signedTx": {
                      "type": "string",
                      "pattern": "^0x([0-9a-fA-F]{2})*$"
                    },
                    "txHash": {
                      "type": "string",
                      "pattern": "^0x([0-9a-fA-F]{2})*$"
                    },
                    "accountNonce": {
                      "type": "string"
                    },
                    "gasLimit": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Pedido inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Certificado de cliente no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto (nonce, versión de policy, tope)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Rechazo definitivo (reglas estáticas, sesión, policy, Guard, simulación)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "No disponible (RPC, shard no listo, pausa por integridad)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sign-platform-tx": {
      "post": {
        "summary": "Firma de la cuenta gas tank (shard platform): recarga, deploy de Safe o relay de cancelación [B-SIG-05]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "TOPUP",
                      "DEPLOY",
                      "CANCEL_RELAY"
                    ]
                  },
                  "chainId": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "to": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,77})$"
                  },
                  "data": {
                    "type": "string"
                  },
                  "safe": {
                    "type": "string"
                  },
                  "executorAttestation": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "walletId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "reference": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "policySnapshotVersion": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "execution": {
                    "type": "object",
                    "properties": {
                      "accountNonce": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      },
                      "maxFeePerGas": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      },
                      "maxPriorityFeePerGas": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      },
                      "gasLimit": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,77})$"
                      }
                    },
                    "required": [
                      "accountNonce",
                      "maxFeePerGas",
                      "maxPriorityFeePerGas"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "purpose",
                  "chainId",
                  "to",
                  "value",
                  "data",
                  "policySnapshotVersion",
                  "execution"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{40}$"
                    },
                    "signedTx": {
                      "type": "string",
                      "pattern": "^0x([0-9a-fA-F]{2})*$"
                    },
                    "txHash": {
                      "type": "string",
                      "pattern": "^0x([0-9a-fA-F]{2})*$"
                    },
                    "accountNonce": {
                      "type": "string"
                    },
                    "gasLimit": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Pedido inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Certificado de cliente no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto (nonce, versión de policy, tope)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Rechazo definitivo (reglas estáticas, sesión, policy, Guard, simulación)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "No disponible (RPC, shard no listo, pausa por integridad)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/gas-tank": {
      "get": {
        "summary": "Dirección de la cuenta gas tank (shard platform)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "address": {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{40}$"
                    },
                    "shardId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Certificado de cliente no autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/metrics": {
      "get": {
        "summary": "Métricas Prometheus del shard",
        "responses": {
          "200": {
            "description": "text/plain; version=0.0.4",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "mtls": {
        "type": "mutualTLS",
        "description": "Certificado de cliente de la CA del entorno (CN o SAN DNS mtw-backend)."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "BAD_REQUEST",
              "UNAUTHORIZED_CLIENT",
              "NOT_FOUND",
              "STATIC_RULE_VIOLATION",
              "POLICY_VERSION_MISMATCH",
              "SESSION_INVALID",
              "SIGNATURE_STALE",
              "COOPERATION_PAUSED",
              "OWNER_SIGNATURE_INVALID",
              "OWNER_NOT_ROLE",
              "SAFE_NOT_REGISTERED",
              "SAFE_CONFIG_MODIFIED",
              "KEY_NOT_FOUND",
              "NONCE_NOT_REACHED",
              "NONCE_CONSUMED",
              "POLICY_REJECTED",
              "GUARD_WOULD_REVERT",
              "SAFE_NONCE_CONFLICT",
              "ACCOUNT_NONCE_MISMATCH",
              "INSUFFICIENT_GAS_FUNDS",
              "SIMULATION_REVERTED",
              "GAS_TANK_CAP_EXCEEDED",
              "PLATFORM_TX_REJECTED",
              "RPC_UNAVAILABLE",
              "RPC_DISAGREEMENT",
              "SIGNER_NOT_READY",
              "INTERNAL"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Detalle estable: regla estática, código de policy, motivo del Guard."
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
