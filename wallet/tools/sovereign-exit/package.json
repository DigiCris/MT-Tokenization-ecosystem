{
  "name": "mtw-sovereign-exit",
  "version": "0.0.0",
  "private": true,
  "description": "Herramienta offline de salida soberana de MT Wallet (P19.T09): un único HTML reproducible y firmado que descifra U y R en la máquina del usuario, arma y firma una SafeTx tipada con las dos y transmite execTransaction por el RPC que el usuario indique.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "build": "vite build",
    "build:release": "vite build && node scripts/sign-release.ts",
    "verify": "node scripts/verify-release.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:e2e": "node scripts/test-e2e.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
