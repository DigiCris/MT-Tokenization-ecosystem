{
  "name": "mtw-frontend-recovery",
  "version": "0.0.0",
  "private": true,
  "description": "App Recovery de MT Wallet (trust domain de R): proyecto independiente, sin código compartido con Wallet; wagmi y conectores sólo en el chunk lazy de wallet externa.",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "26.12.0"
  },
  "scripts": {
    "tokens": "node scripts/sync-design-tokens.mjs",
    "tokens:check": "node scripts/sync-design-tokens.mjs --check",
    "vectors": "node scripts/sync-vectors.mjs",
    "vectors:check": "node scripts/sync-vectors.mjs --check",
    "abis": "node scripts/sync-abis.mjs",
    "abis:check": "node scripts/sync-abis.mjs --check",
    "dev": "node scripts/sync-design-tokens.mjs && vite",
    "build": "node scripts/sync-design-tokens.mjs && vite build",
    "build:release": "node scripts/sync-design-tokens.mjs && vite build && node build/sign-manifest.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "eslint --max-warnings 0 . && node scripts/lint-fixtures.mjs && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:drive-live": "vitest run --config vitest.live.config.ts",
    "test:browser": "node scripts/test-browser.mjs",
    "verify:manifest": "node build/verify-manifest.ts"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "4.4.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "5.104.1",
    "@wagmi/connectors": "8.2.0",
    "@wagmi/core": "3.6.5",
    "@walletconnect/ethereum-provider": "2.26.0",
    "qr": "0.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "viem": "2.57.4",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@reown/walletkit": "1.6.0",
    "@serenity-kit/opaque": "1.1.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@walletconnect/core": "2.25.0",
    "@walletconnect/utils": "2.25.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
