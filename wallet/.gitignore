# --- Secretos y entorno local: nunca commitear ---
.env
.env.*
!.env.example
!.env.production.example
.secrets/

# --- Toolchain local del proyecto (scripts/tools/bootstrap) ---
.tools/

# --- Dependencias, builds y reportes ---
.backups/
node_modules/
dist/
coverage/
*.log
# build/ dentro de los frontends es código fuente (plugins y scripts del build y sus tests, P16): el .gitignore de la raíz
# del repositorio ignora cualquier build/.
!frontend/**/build/

# --- Foundry ---
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/deployments/local.json
contracts/deployments/ci.json
# JSON de deploys efímeros de los tests de otros proyectos (DEPLOYMENT_TAG).
contracts/deployments/local-*.json
contracts/deployments/ci-*.json
# Snapshot de policy local: sale del deploy local (LOCAL_SEED de cada desarrollador) y se firma con su clave local.
config/policy/local/

# --- Playwright ---
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/

# --- Sistema / editor ---
.DS_Store
contracts/dependencies/
contracts/out-noopt/
contracts/cache-noopt/
